# Vyria Delivery — copia para .env.local (dev) ou define no painel Vercel (produção).
# Não commits ficheiros com segredos reais.

# --- Supabase (projeto → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Obrigatório no servidor (webhooks / rotas server-side que ignoram RLS), ex.: POST /api/webhooks/whatsapp
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: UUID da única conta com acesso a /admin (substitui o valor em lib/admin-panel-user.ts)
# VYRIA_ADMIN_USER_ID=

# --- Evolution API (stack Docker: ver evolution-stack.env.example + docker-compose.yml) ---
# EVOLUTION_API_BASE_URL = base pública da API (mesmo host/porta/path que SERVER_URL na Evolution, sem barra final).
# Ex.: http://IP:8080 ou https://evolution.seudominio.com
EVOLUTION_API_BASE_URL=
# EVOLUTION_API_KEY = mesmo valor que AUTHENTICATION_API_KEY no .env da stack Evolution.
EVOLUTION_API_KEY=
# URL pública do painel Vyria (HTTPS, sem barra final). Obrigatório em produção para registar o webhook
# na Evolution e receber mensagens (respostas automáticas). Ex.: https://acesso.vyriadelivery.com.br
VYRIA_PUBLIC_URL=

# --- OpenAI (opcional: import de menu por foto, descrições/imagens de produto) ---
OPENAI_API_KEY=

# --- Admin / notificações (cobrança manual) ---
# Email que recebe alertas de novo cadastro e vencimentos (Resend).
ADMIN_EMAIL=seuemail@gmail.com
# Chave API Resend (https://resend.com) — envio de emails ao admin.
RESEND_API_KEY=
# Remetente verificado no Resend (opcional; default onboarding@resend.dev só em testes).
# RESEND_FROM=Vyria <noreply@seudominio.com>
# WhatsApp do suporte (apenas dígitos, com DDI) — /acesso-suspenso e /planos (NEXT_PUBLIC para o cliente).
NEXT_PUBLIC_ADMIN_WHATSAPP=5562999999999
# Opcional (só servidor): fallback para link WhatsApp em /planos se não usares NEXT_PUBLIC.
# ADMIN_WHATSAPP=5562999999999

# Cron diário (bloqueio por vencimento + email) — protege GET /api/cron/verificar-vencimentos
CRON_SECRET=
# Job local com `next start`: ENABLE_SERVER_CRON=true agenda 8h America/Sao_Paulo via node-cron
# ENABLE_SERVER_CRON=

# --- Só desenvolvimento (ignorado em produção para planos) ---
# VYRIA_DEV_FORCE_PLAN=GROWTH
# VYRIA_DEV_PRO_EMAILS=email1@test.com,email2@test.com
