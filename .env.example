## Public (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URLs de redirecionamento no Supabase: Authentication → URL Configuration → Redirect URLs.
# Inclui o domínio de produção e http://localhost:3000 (ou a porta local), por exemplo:
#   https://teu-dominio.com/login/redefinir-senha
#   http://localhost:3000/login/redefinir-senha
VYRIA_PUBLIC_URL=
# Mesma URL acima, exposta ao cliente (recuperação de senha). Ex.: http://acesseseusistemavyria.online
NEXT_PUBLIC_VYRIA_PUBLIC_URL=
# Host(s) onde / redireciona para /login (sem protocolo). Ex.: acesseseusistemavyria.online
AUTH_PORTAL_HOSTS=

## Server-only (required for API routes that bypass RLS)
# Use ONE of the keys below (preferred is SUPABASE_SERVICE_ROLE_KEY).
# Painel /admin e /api/admin/* precisam disto para listar e gerir todas as lojas.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_KEY=
# SUPABASE_SERVICE_ROLE=

## Optional integrations
OPENAI_API_KEY=
# Fiscal (NFC-e via Brasil NFe). Modelo master: a Vyria possui a conta (UserToken)
# e cada loja é uma "Empresa" (Token guardado em store_fiscal_config.brasilnfe_token).
# BRASIL_NFE_API_URL = raiz dos serviços (/fiscal/* e /empresa/* são derivados daqui).
BRASIL_NFE_API_URL=https://api.brasilnfe.com.br/services
# UserToken da conta Vyria — necessário para cadastrar empresas e subir certificados.
BRASIL_NFE_USER_TOKEN=
# Link de checkout do add-on Vyria Fiscal (R$ 39,90/mês) — abre em iframe no painel.
NEXT_PUBLIC_FISCAL_CHECKOUT_URL=
# WhatsApp de suporte (usado no botão "Falar com suporte" do Vyria Fiscal).
NEXT_PUBLIC_ADMIN_WHATSAPP=

## Contrato anual — assinatura eletrónica e prova jurídica
# Dados da contratada (Vyria) impressos no PDF e no registo canónico.
VYRIA_RAZAO_SOCIAL=
VYRIA_CNPJ=
VYRIA_FORO_COMARCA=
VYRIA_TERMOS_URL=
VYRIA_EMAIL_JURIDICO=
# E-mail administrativo (cópia do PDF assinado + notificações).
ADMIN_EMAIL=
# Resend — envio do PDF assinado ao lojista e à Vyria após aceite.
RESEND_API_KEY=
RESEND_FROM=

## Cron e segurança
CRON_SECRET=
# HMAC para token de acesso ao PIX pós-checkout (recomendado; pode reutilizar CRON_SECRET).
CHECKOUT_ACCESS_SECRET=
# Bloqueio manual de IPs abusivos (vírgula). Ex.: 203.0.113.50,198.51.100.22
ABUSE_IP_BLOCKLIST=
# IPs que nunca são bloqueados automaticamente (opcional).
ABUSE_IP_ALLOWLIST=
# UUID da conta Supabase Auth com acesso ao painel /admin (obrigatório em produção).
VYRIA_ADMIN_USER_ID=
# IPs permitidos para /admin e /api/admin (opcional; vírgula). Ex.: 203.0.113.10,127.0.0.1
ADMIN_IP_ALLOWLIST=
# Assinatura HMAC do cookie de impersonation (mín. 16 chars; pode igualar CRON_SECRET).
IMPERSONATION_COOKIE_SECRET=

## Web Push (opcional — alerta no browser ao receber pedido)
# Gerar: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_SUBJECT=mailto:seu-email@exemplo.com
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

## Agente de impressão local (pasta agent/)
# AGENT_TOKEN=   # obrigatório, mín. 16 caracteres
# AGENT_HOST=127.0.0.1

