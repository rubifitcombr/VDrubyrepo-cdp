# Evolution + Postgres + Redis (mesma pasta que docker-compose.yml)
#
# No servidor:
#   cp evolution-stack.env.example .env
#   nano .env
#
# Alinhamento com a app Next (Vercel / .env.local):
#   AUTHENTICATION_API_KEY aqui  ===  EVOLUTION_API_KEY
#   SERVER_URL (origem pública, sem barra final)  ===  EVOLUTION_API_BASE_URL
#
# POSTGRES_PASSWORD deve ser IGUAL à password do user `evolution` na URI abaixo
# (o compose monta DATABASE_CONNECTION_URI a partir desta variável).
# Se já tens volume Postgres antigo, usa a MESMA password que na primeira subida.

POSTGRES_PASSWORD=defina_uma_senha_forte
AUTHENTICATION_API_KEY=defina_a_mesma_chave_que_EVOLUTION_API_KEY_na_Vercel

# --- SERVER_URL (público, sem barra final) ---
# Obrigatório para a Evolution (webhooks, links, etc.).
#
# HTTP + IP (ex.: http://185.225.233.14:8080) pode funcionar em lab, mas:
#   - alguns providers exigem HTTPS para callbacks;
#   - sem TLS, integrações e debugging ficam mais frágeis.
#
# Alvo em produção: HTTPS atrás de Nginx/Caddy/Traefik + Let's Encrypt, por exemplo:
#   SERVER_URL=https://evolution.seudominio.com
# O proxy termina TLS e encaminha para o container na porta 8080; SERVER_URL é o que o mundo vê.
#
# Se ainda não tens domínio: aceita o trade-off por agora e planeia SSL antes de escalar.

SERVER_URL=https://evolution.seudominio.com

# --- Redis: DB lógico (0–15) ---
# Este compose sobe um Redis dedicado à stack: o padrão é /0 (simples e previsível).
# Só uses outro índice (ex. /6) se o MESMO servidor Redis for partilhado com outra app —
# aí defines um DB por serviço e documentas para não misturar fila/cache/sessão.

CACHE_REDIS_URI=redis://redis:6379/0
