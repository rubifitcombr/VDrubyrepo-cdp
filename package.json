{
  "name": "vyria-delivery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "build:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "eslint",
    "test:master": "node scripts/test-master-release.mjs",
    "e2e:provision": "node scripts/provision-e2e-test-store.mjs",
    "e2e:audit-damage": "node scripts/audit-e2e-historical-damage.mjs",
    "e2e:correction-report": "node scripts/e2e-correction-report.mjs",
    "test:sync": "node scripts/ensure-e2e-test-env.mjs && npm run build && playwright test e2e/sync",
    "test:sync:stable": "node scripts/ensure-e2e-test-env.mjs && npm run build && bash scripts/run-sync-tests-3x.sh",
    "test:concurrency": "node scripts/ensure-e2e-test-env.mjs && npm run build && node scripts/apply-concurrency-migration.mjs && playwright test -c playwright.concurrency.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "brasilnfe": "^2.0.0",
    "iconv-lite": "^0.7.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "next": "16.2.2",
    "node-cron": "^4.2.1",
    "openai": "^6.34.0",
    "pix-utils": "^2.8.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-bluetooth": "^0.0.21",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
