# Loja dedicada para testes E2E (sync + concorrência).
# Copie para .env.test e execute: npm run e2e:provision

# Slug e ID da loja de teste (preenchidos automaticamente pelo provision)
E2E_STORE_SLUG=e2e-test-store
E2E_STORE_ID=

# Conta Auth dedicada (criada por e2e:provision) — NÃO usar email de loja real
E2E_OWNER_EMAIL=vyria-e2e-automation@vyria.test

# NUNCA true em desenvolvimento normal — permite rodar contra loja real (ex.: tudibom)
# E2E_ALLOW_PRODUCTION_STORE=false

# Opcional: de qual loja copiar o owner_id na primeira provisionagem
# E2E_PROVISION_OWNER_FROM_SLUG=tudibom
